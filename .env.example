ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://agenticrag:agenticrag@127.0.0.1:5432/agenticrag
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900

# Identity provider (Keycloak in docker compose). Use the same host in the SPA.
# Production: https issuer from Auth0 / Cognito / Entra; keep audience as the API identifier.
OIDC_ISSUER=http://127.0.0.1:8080/realms/agenticrag
OIDC_AUDIENCE=agenticrag-api
OIDC_SPA_CLIENT_ID=agenticrag-spa
# Optional override; otherwise discovered from {issuer}/.well-known/openid-configuration
OIDC_JWKS_URL=

LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
