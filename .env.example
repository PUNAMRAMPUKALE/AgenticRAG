# Optional. Without a key, the API still answers from retrieved chunks (extractive MVP).
LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Shared by every API replica. Default matches docker compose redis.
REDIS_URL=redis://127.0.0.1:6379/0
# How long a cached answer lives (seconds). 900 = 15 minutes.
CACHE_TTL_SECONDS=900

# Sign JWTs. Change this in any real deploy.
JWT_SECRET=dev-only-change-me
JWT_HOURS=12
