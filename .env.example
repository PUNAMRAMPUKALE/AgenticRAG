ENVIRONMENT=development

# PostgreSQL (docker compose service "postgres")
DATABASE_URL=postgresql+asyncpg://agenticrag:agenticrag@127.0.0.1:5432/agenticrag

REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900

# Local UI sign-in. For real deploys: ENVIRONMENT=production AUTH_ALLOW_DEV_LOGIN=false
# and a long random JWT_SECRET; verify tokens from your IdP instead of POST /v1/auth/token.
JWT_SECRET=dev-only-change-me
JWT_HOURS=12
AUTH_ALLOW_DEV_LOGIN=true

LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
