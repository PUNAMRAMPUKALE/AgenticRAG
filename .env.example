ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://agenticrag:agenticrag@127.0.0.1:5432/agenticrag
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://127.0.0.1:5173
# Authorized redirect URIs: http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
# Comma-separated Google emails. Default signed-in user is analyst.
GOOGLE_ANALYST_EMAILS=
GOOGLE_SENIOR_ANALYST_EMAILS=
# Manager (expert) can reindex the knowledge base
GOOGLE_MANAGER_EMAILS=
# Optional: only allow a Workspace domain, e.g. yourcompany.com
GOOGLE_ALLOWED_DOMAIN=
SESSION_HOURS=12

# Auto-chunk markdown, PDF, and Excel under backend/knowledge/ on create/update/delete
KNOWLEDGE_WATCH=true
KNOWLEDGE_WATCH_DEBOUNCE_MS=800
KNOWLEDGE_POLL_SECONDS=5
# local = watch backend/knowledge/. s3 = read objects from the bucket into memory (no disk copy)
KNOWLEDGE_SOURCE=local
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_PREFIX=knowledge
KNOWLEDGE_S3_REGION=
KNOWLEDGE_S3_POLL_SECONDS=30
# Optional: S3 event notifications → SQS for faster sync
KNOWLEDGE_S3_QUEUE_URL=

# Optional Vespa (indexes + retrieval). Leave empty to keep in-memory TF-IDF only.
VESPA_URL=

LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Same OpenAI key is used for embeddings. One model for chunk splits + query vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
