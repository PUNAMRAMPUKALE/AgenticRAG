ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://agenticrag:agenticrag@127.0.0.1:5432/agenticrag
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://127.0.0.1:5173
# Authorized redirect URIs: http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
# Comma-separated Google emails. Default signed-in user is analyst.
GOOGLE_ANALYST_EMAILS=
GOOGLE_SENIOR_ANALYST_EMAILS=
# Manager (expert) can reindex the knowledge base
GOOGLE_MANAGER_EMAILS=
# Optional: only allow a Workspace domain, e.g. yourcompany.com
GOOGLE_ALLOWED_DOMAIN=
SESSION_HOURS=12

LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
