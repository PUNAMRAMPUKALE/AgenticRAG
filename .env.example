ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://agenticrag:agenticrag@127.0.0.1:5432/agenticrag
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=900

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins: http://127.0.0.1:5173
# Authorized redirect URIs: http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_ANALYST_EMAILS=
GOOGLE_SENIOR_ANALYST_EMAILS=
GOOGLE_MANAGER_EMAILS=
GOOGLE_ALLOWED_DOMAIN=
SESSION_HOURS=12

# Knowledge source: s3 (bucket is source of truth) or local (backend/knowledge/)
KNOWLEDGE_SOURCE=s3
KNOWLEDGE_S3_BUCKET=agenticrag-knowledge-punam
KNOWLEDGE_S3_PREFIX=fintech_company_knowledge_base_30_40_pages
KNOWLEDGE_S3_REGION=us-east-2
KNOWLEDGE_S3_POLL_SECONDS=30
KNOWLEDGE_S3_QUEUE_URL=
# IAM user keys for local/dev only. Do not commit real values. Production should use an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# Used only when KNOWLEDGE_SOURCE=local
KNOWLEDGE_WATCH=true
KNOWLEDGE_WATCH_DEBOUNCE_MS=800
KNOWLEDGE_POLL_SECONDS=5

VESPA_URL=http://127.0.0.1:8080
VESPA_CONFIG_URL=http://127.0.0.1:19071

LLM_API_KEY=
LLM_CHOICE=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
